{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "statusMessage": "Running lint + tests before commit (skipped for docs-only)…",
            "timeout": 180,
            "command": "bash /home/user/smart-thermostat-with-vents/.claude/hooks/precommit-gate.sh"
          }
        ]
      }
    ]
  }
}
